#!/usr/bin/env bash
# Run all tests for review-code

set -euo pipefail

# Get script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

# shellcheck source=helpers/_utils.sh
source "${SCRIPT_DIR}/helpers/_utils.sh"

print_color green "Running review-code tests…"
echo

# Check if bats is installed
if ! command_exists bats; then
    error "bats is not installed"
    echo "Install with: brew install bats-core"
    exit 1
fi

# Run unit tests
print_color yellow "=== Unit Tests ==="
if bats "${ROOT_DIR}/tests/unit/"*.bats; then
    echo
    success "All unit tests passed!"
    echo
else
    echo
    print_color red "✗ Some unit tests failed"
    exit 1
fi

# Run integration tests if they exist
if [[ -d "${ROOT_DIR}/tests/integration" ]] && [[ -n "$(ls -A "${ROOT_DIR}/tests/integration"/*.bats 2> /dev/null)" ]]; then
    print_color yellow "=== Integration Tests ==="
    if bats "${ROOT_DIR}/tests/integration/"*.bats; then
        echo
        success "All integration tests passed!"
        echo
    else
        echo
        print_color red "✗ Some integration tests failed"
        exit 1
    fi
fi

print_color green "========================================"
success "All tests passed!"
print_color green "========================================"
