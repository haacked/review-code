#!/usr/bin/env python3
"""token-report - Measure what reviews actually cost.

The skill's own token log (.reviews/token-usage.jsonl) only sees subagents.
The orchestrating conversation is roughly half the bill and is invisible from
inside a review, so it has to be measured from the session transcripts.
"""

import argparse
import collections
import datetime
import glob
import json
import os
import re
import sys

# Per-million-token rates. Reviews run mostly on the top tier; subagents pinned
# to cheaper models are priced by the model recorded in their own transcript.
Rate = collections.namedtuple("Rate", "input cache_write cache_read output")
RATES = {
    "opus":   Rate(15.0, 18.75, 1.5, 75.0),
    "sonnet": Rate(3.0, 3.75, 0.3, 15.0),
    "haiku":  Rate(1.0, 1.25, 0.1, 5.0),
}


def transcript_root(value):
    """argparse type for --dir, applied to the default as well as a given path."""
    if not os.path.isdir(value):
        sys.exit(f"ERROR: Transcript directory not found: {value}")
    return value


def parse_args():
    parser = argparse.ArgumentParser(
        prog="bin/token-report",
        usage="bin/token-report [options]",
        description=__doc__,
        formatter_class=argparse.RawTextHelpFormatter,
    )
    parser.add_argument(
        "--dir", metavar="<path>", type=transcript_root,
        default=os.path.expanduser("~/.claude/projects"),
        help="Transcript root (default: ~/.claude/projects)")
    parser.add_argument(
        "--match", metavar="<substr>", default="review",
        help="Only sessions whose project directory contains this\n"
             "(default: review, which picks up review worktrees)")
    parser.add_argument(
        "--since", metavar="<date>", default="",
        help="ISO date; skip sessions whose first entry predates it")
    parser.add_argument(
        "--limit", metavar="<n>", type=int, default=15,
        help="Show at most n sessions in the per-session table")
    parser.add_argument(
        "--json", action="store_true",
        help="Emit machine-readable JSON instead of a table")
    parser.add_argument(
        "--prompts", action="store_true",
        help="Report how reviewer subagents received their payload\n"
             "(inlined in the prompt, or by a path to a file) instead\n"
             "of the cost tables")
    return parser.parse_args()


def median(xs):
    # Lower median on even-length input. statistics.median averages the two
    # middle values, which would invent a figure no session actually cost.
    xs = sorted(xs)
    return xs[len(xs) // 2] if xs else 0


# =============================================================================
# --prompts: how reviewer agents received their payload
# =============================================================================

# Before build-agent-briefing.sh standardized one filename, the orchestrator
# invented its own each run: /tmp/rc-<n>-agent-context.md, shared_context.md,
# briefing.md, pr<n>-arch.md. Matching any absolute path to a text-ish file
# catches the whole family instead of guessing at the names.
PATH_HINT = re.compile(r"(/[\w.\-]+){2,}\.(md|diff|patch|txt)\b")


def first_user_prompt(path):
    with open(path, errors="ignore") as fh:
        for line in fh:
            try:
                rec = json.loads(line)
            except ValueError:
                continue
            msg = rec.get("message") or {}
            if msg.get("role") != "user":
                continue
            c = msg.get("content")
            if isinstance(c, str):
                return c
            if isinstance(c, list):
                t = "".join(b.get("text", "") for b in c
                            if isinstance(b, dict) and b.get("type") == "text")
                if t:
                    return t
    return None


def shape(text):
    if text.strip() == "FILE_PROMPT_PLACEHOLDER":
        return None                      # harness artifact, not a real prompt
    if "diff --git" in text:
        return "inlined"
    if PATH_HINT.search(text):
        return "by-reference"
    return "no-payload"


def report_prompts(root, match, as_json):
    rows = []
    for project in sorted(glob.glob(os.path.join(root, "*"))):
        if match and match not in os.path.basename(project):
            continue
        for subdir in glob.glob(os.path.join(project, "*", "subagents")):
            for f in sorted(glob.glob(os.path.join(subdir, "*.jsonl"))):
                meta = f[:-6] + ".meta.json"
                if not os.path.exists(meta):
                    continue
                try:
                    with open(meta) as fh:
                        atype = json.load(fh).get("agentType") or ""
                except ValueError:
                    continue
                if not atype.startswith("code-reviewer-"):
                    continue
                text = first_user_prompt(f)
                if not text:
                    continue
                k = shape(text)
                if k:
                    rows.append({"agent": atype, "shape": k, "tokens": len(text) // 4})

    if not rows:
        print(f"No reviewer subagents matched '{match}' under {root}")
        return

    by_shape = collections.defaultdict(list)
    for r in rows:
        by_shape[r["shape"]].append(r["tokens"])

    if as_json:
        print(json.dumps({"reviewer_dispatches": len(rows),
                          "by_shape": {k: {"n": len(v), "median_tokens": median(v)}
                                       for k, v in by_shape.items()},
                          "rows": rows}, indent=2))
        return

    print(f"{len(rows)} reviewer-agent dispatches under {root} matching '{match}'\n")
    print(f"{'prompt shape':<16} {'n':>5} {'pct':>6} {'median tok':>11} {'p90':>8}")
    for k in ("inlined", "by-reference", "no-payload"):
        v = by_shape.get(k) or []
        if not v:
            continue
        p90 = sorted(v)[int(len(v) * 0.9)]
        print(f"{k:<16} {len(v):>5} {100 * len(v) / len(rows):>5.0f}% {median(v):>11,} {p90:>8,}")

    print("\n  inlined      the diff is in the prompt text")
    print("  by-reference the prompt names a file holding the payload")
    print("  no-payload   neither; the agent was told to fetch the diff itself")


# =============================================================================
# Cost tables
# =============================================================================

def tier(model):
    m = (model or "").lower()
    for name in ("haiku", "sonnet", "opus"):
        if name in m:
            return name
    return "opus"


def scan(path):
    """Sum usage for one transcript.

    Claude Code writes one line per content block, and every line of a single
    API response repeats that response's usage object. Summing naively
    multiplies the real cost several times over, so entries are deduplicated by
    message id first.
    """
    totals = collections.Counter()
    cost = 0.0
    seen = set()
    first_ts = None
    with open(path, errors="ignore") as fh:
        for line in fh:
            try:
                rec = json.loads(line)
            except ValueError:
                continue
            if first_ts is None and rec.get("timestamp"):
                first_ts = rec["timestamp"]
            msg = rec.get("message") or {}
            usage = msg.get("usage")
            if not usage:
                continue
            key = msg.get("id") or rec.get("requestId") or rec.get("uuid")
            if key in seen:
                continue
            seen.add(key)
            i = usage.get("input_tokens", 0)
            o = usage.get("output_tokens", 0)
            cw = usage.get("cache_creation_input_tokens", 0)
            cr = usage.get("cache_read_input_tokens", 0)
            totals["in"] += i
            totals["out"] += o
            totals["cache_write"] += cw
            totals["cache_read"] += cr
            totals["context"] += i + cw + cr
            r = RATES[tier(msg.get("model"))]
            cost += (i * r.input + cw * r.cache_write + cr * r.cache_read + o * r.output) / 1e6
    return totals, len(seen), cost, first_ts


def mix(c):
    r = RATES["opus"]
    tot = (c["in"] * r.input + c["cache_write"] * r.cache_write
           + c["cache_read"] * r.cache_read + c["out"] * r.output)
    if not tot:
        return {}
    return {"cache_read_pct": round(100 * c["cache_read"] * r.cache_read / tot),
            "output_pct": round(100 * c["out"] * r.output / tot),
            "cache_write_pct": round(100 * c["cache_write"] * r.cache_write / tot)}


def report_costs(root, match, since, limit, as_json):
    cutoff = None
    if since:
        try:
            cutoff = datetime.datetime.fromisoformat(since).replace(tzinfo=datetime.timezone.utc)
        except ValueError:
            print(f"ERROR: --since must be an ISO date, got: {since}", file=sys.stderr)
            sys.exit(1)

    sessions = []
    agg_o, agg_s = collections.Counter(), collections.Counter()
    for project in sorted(glob.glob(os.path.join(root, "*"))):
        if match and match not in os.path.basename(project):
            continue
        for main in glob.glob(os.path.join(project, "*.jsonl")):
            ot, turns, ocost, ts = scan(main)
            if turns < 3:
                continue
            if cutoff and ts:
                try:
                    if datetime.datetime.fromisoformat(ts.replace("Z", "+00:00")) < cutoff:
                        continue
                except ValueError:
                    pass
            sid = os.path.basename(main)[:-6]
            st, scost, nsub = collections.Counter(), 0.0, 0
            for sub in glob.glob(os.path.join(project, sid, "subagents", "*.jsonl")):
                t, _, c, _ = scan(sub)
                st += t
                scost += c
                nsub += 1
            agg_o += ot
            agg_s += st
            sessions.append({
                "project": os.path.basename(project), "session": sid, "started": ts,
                "orchestrator_usd": round(ocost, 2), "subagent_usd": round(scost, 2),
                "total_usd": round(ocost + scost, 2), "turns": turns, "subagents": nsub,
                "avg_context_per_turn": int(ot["context"] / turns) if turns else 0,
                "orchestrator_output_tokens": ot["out"],
            })

    if not sessions:
        print(f"No sessions matched '{match}' under {root}")
        return

    sessions.sort(key=lambda s: -s["total_usd"])
    totals = [s["total_usd"] for s in sessions]

    summary = {
        "sessions": len(sessions),
        "median_usd": median(totals),
        "mean_usd": round(sum(totals) / len(totals), 2),
        "total_usd": round(sum(totals), 2),
        "median_turns": median([s["turns"] for s in sessions]),
        "median_context_per_turn": median([s["avg_context_per_turn"] for s in sessions]),
        "orchestrator_cost_mix": mix(agg_o),
        "subagent_cost_mix": mix(agg_s),
    }

    if as_json:
        print(json.dumps({"summary": summary, "sessions": sessions[:limit]}, indent=2))
        return

    print(f"Review token report - {len(sessions)} sessions under {root} matching '{match}'")
    if since:
        print(f"  since {since}")
    print()
    print(f"{'PROJECT':<42}{'$orch':>9}{'$subs':>9}{'$total':>9}{'turns':>7}{'ctx/turn':>10}{'subs':>6}")
    for s in sessions[:limit]:
        print(f"{s['project'][-42:]:<42}{s['orchestrator_usd']:>9.2f}{s['subagent_usd']:>9.2f}"
              f"{s['total_usd']:>9.2f}{s['turns']:>7}{s['avg_context_per_turn']:>10,}{s['subagents']:>6}")
    if len(sessions) > limit:
        print(f"… and {len(sessions) - limit} more (raise --limit to see them)")
    print()
    print(f"  median ${summary['median_usd']:.2f}/review   mean ${summary['mean_usd']:.2f}   total ${summary['total_usd']:,.2f}")
    print(f"  median {summary['median_turns']} orchestrator turns at {summary['median_context_per_turn']:,} tokens of context each")
    om, sm = summary["orchestrator_cost_mix"], summary["subagent_cost_mix"]
    if om:
        print(f"  orchestrator: cache-read {om['cache_read_pct']}%  output {om['output_pct']}%  cache-write {om['cache_write_pct']}%")
    if sm:
        print(f"  subagents:    cache-read {sm['cache_read_pct']}%  output {sm['output_pct']}%  cache-write {sm['cache_write_pct']}%")
    o = sum(s["orchestrator_usd"] for s in sessions)
    t = sum(totals)
    if t:
        print(f"  split: orchestrator {100 * o / t:.0f}% / subagents {100 * (t - o) / t:.0f}%")


def main():
    args = parse_args()
    if args.prompts:
        report_prompts(args.dir, args.match, args.json)
    else:
        report_costs(args.dir, args.match, args.since, args.limit, args.json)


if __name__ == "__main__":
    main()
