new file mode 100644
index 0000000000000..6b269b42c9a29
--- /dev/null
+++ b/products/today/backend/logic/highlight_sources/flags.py
@@ -0,0 +1,119 @@
+import re
+
+from django.utils import timezone
+
+from posthog.constants import PRODUCT_TOUR_TARGETING_FLAG_PREFIX, SURVEY_TARGETING_FLAG_PREFIX
+
+from products.feature_flags.backend.facade.usage import (
+    FLAG_CALL_DAYS,
+    CreatedFlag,
+    FlagCalls,
+    list_flags_created_by,
+    summarize_flag_calls,
+)
+
+from ...facade.enums import HighlightLabel
+from ..highlight_rules import exact, human
+from ..highlight_types import Candidate, Context, Found, Source
+
+REACH_DROP = "Flag ‘{flag}’ reached {pct}% fewer users in the last 7 days"
+REACH_DROP_DETAIL = "{before} → {now} · Check the code that calls it"
+UNUSED_ONE = "Flag ‘{flag}’ had no evaluations in the last 14 days"
+UNUSED_ONE_DETAIL = "Delete it if no code uses it"
+SAME_ONE = "Flag ‘{flag}’ is {value} for everyone"
+SAME_ONE_DETAIL = "Remove it from the code, then delete it"
+CLEANUP_MANY = "{n} of your flags are unused or the same for everyone"
+CLEANUP_COST = "{n} of your flags were called {cost} times in the last 7 days"
+CLEANUP_COST_DETAIL = "Same value for everyone: {names}"
+AND_MORE = "{names} and {n} more"
+
+INTERNAL_FLAG_PREFIXES = (SURVEY_TARGETING_FLAG_PREFIX, PRODUCT_TOUR_TARGETING_FLAG_PREFIX)
+RISKY_FLAGS = re.compile(r"(?i)(kill|override|switch|disable|maintenance|remote-config)|-[0-9a-f]{8,}$")
+MIN_REACH = 20
+SAME_VALUE_MIN_AGE_DAYS = 30
+CLEANUP_COST_MIN = 100_000
+NO_CALLS = FlagCalls(
+    people_this_week=0, people_last_week=0, calls_this_week=0, calls=0, values_this_week=0, value_this_week=None
+)
+
+
+def find(context: Context) -> Found:
+    flags = [
+        flag
+        for flag in list_flags_created_by(context.team.id, context.user.id, limit=500)
+        if not flag.remote_configuration and not flag.key.startswith(INTERNAL_FLAG_PREFIXES)
+    ]
+    if not flags:
+        return Found()
+    summary = context.daily("flag_calls", lambda: summarize_flag_calls(context.team, context.user))
+    items: list[Candidate] = []
+    removable: list[CreatedFlag] = []
+    same: list[tuple[CreatedFlag, FlagCalls]] = []
+    for flag in flags:
+        calls = summary.by_key.get(flag.key, NO_CALLS)
+        if calls.people_last_week >= MIN_REACH and calls.people_this_week <= calls.people_last_week / 2:
+            items.append(_reach_drop(flag, calls))
+        if flag.removal_blocked or RISKY_FLAGS.search(flag.key) or not summary.covers_all_environments:
+            continue
+        age = (context.today - timezone.localtime(flag.created_at, context.team.timezone_info).date()).days
+        if age >= SAME_VALUE_MIN_AGE_DAYS and calls.people_this_week >= MIN_REACH and calls.values_this_week == 1:
+            removable.append(flag)
+            same.append((flag, calls))
+        elif age >= FLAG_CALL_DAYS and calls.calls == 0 and summary.complete:
+            removable.append(flag)
+    if cleanup := _cleanup(context, removable, same):
+        items.append(cleanup)
+    return Found(items=tuple(items))
+
+
+def _reach_drop(flag: CreatedFlag, calls: FlagCalls) -> Candidate:
+    return Candidate(
+        key=f"flag_reach_drop:{flag.id}",
+        label=HighlightLabel.RISK,
+        family="flags",
+        importance=0.6,
+        relevance=1.0,
+        title=REACH_DROP.format(
+            flag=flag.key, pct=f"{(1 - calls.people_this_week / calls.people_last_week) * 100:.0f}"
+        ),
+        detail=REACH_DROP_DETAIL.format(now=exact(calls.people_this_week), before=exact(calls.people_last_week)),
+        url=f"/feature_flags/{flag.id}",
+    )
+
+
+def _listing(keys: list[str]) -> str:
+    names = ", ".join(keys[:3])
+    return AND_MORE.format(names=names, n=len(keys) - 3) if len(keys) > 3 else names
+
+
+def _cleanup(
+    context: Context, removable: list[CreatedFlag], same: list[tuple[CreatedFlag, FlagCalls]]
+) -> Candidate | None:
+    if context.today.weekday() == 0 and removable:
+        keys = [flag.key for flag in sorted(removable, key=lambda flag: flag.created_at)]
+        if len(keys) > 1:
+            title, detail = CLEANUP_MANY.format(n=len(keys)), _listing(keys)
+        elif same:
+            title = SAME_ONE.format(flag=keys[0], value=same[0][1].value_this_week or "false")
+            detail = SAME_ONE_DETAIL
+        else:
+            title, detail = UNUSED_ONE.format(flag=keys[0]), UNUSED_ONE_DETAIL
+    else:
+        cost = sum(calls.calls_this_week for _, calls in same)
+        if cost < CLEANUP_COST_MIN:
+            return None
+        title = CLEANUP_COST.format(n=len(same), cost=human(cost))
+        detail = CLEANUP_COST_DETAIL.format(names=_listing([flag.key for flag, _ in same]))
+    return Candidate(
+        key="flag_cleanup",
+        label=HighlightLabel.OPPORTUNITY,
+        family="flag_cleanup",
+        importance=0.3,
+        relevance=1.0,
+        title=title,
+        detail=detail,
+        url="/feature_flags",
+    )
+
+
+SOURCE = Source(name="flags", find=find, scopes=("feature_flag:read",))
diff --git a/products/today/backend/tests/test_highlight_flags.py b/products/today/backend/tests/test_highlight_flags.py
new file mode 100644
index 0000000000000..b466d2476900f
--- /dev/null
+++ b/products/today/backend/tests/test_highlight_flags.py
@@ -0,0 +1,148 @@
+from datetime import UTC, date, datetime, timedelta
+from types import SimpleNamespace
+from typing import cast
+from zoneinfo import ZoneInfo
+
+from unittest.mock import patch
+
+from django.test import SimpleTestCase
+
+from parameterized import parameterized
+
+from products.feature_flags.backend.facade.usage import CreatedFlag, FlagCalls, FlagCallSummary
+from products.today.backend.logic.highlight_registry import load_sources
+from products.today.backend.logic.highlight_sources import flags
+from products.today.backend.logic.highlight_types import Context
+
+MONDAY = date(2026, 10, 12)
+TUESDAY = date(2026, 10, 13)
+
+
+def created(
+    key: str, days_old: int, *, flag_id: int = 1, blocked: bool = False, remote_configuration: bool = False
+) -> CreatedFlag:
+    return CreatedFlag(
+        id=flag_id,
+        key=key,
+        created_at=datetime(2026, 10, 12, 9, tzinfo=UTC) - timedelta(days=days_old),
+        removal_blocked=blocked,
+        remote_configuration=remote_configuration,
+    )
+
+
+def calls(people: int = 0, people_before: int = 0, calls_this_week: int = 0, values: int = 0) -> FlagCalls:
+    return FlagCalls(
+        people_this_week=people,
+        people_last_week=people_before,
+        calls_this_week=calls_this_week,
+        calls=calls_this_week + people_before,
+        values_this_week=values,
+        value_this_week="true" if values else None,
+    )
+
+
+SAME = calls(people=50, calls_this_week=200_000, values=1)
+
+
+class TestFlags(SimpleTestCase):
+    def _find(
+        self,
+        today: date,
+        created_flags: list[CreatedFlag],
+        by_key: dict[str, FlagCalls],
+        *,
+        complete: bool = True,
+        covers_all_environments: bool = True,
+    ) -> list[tuple[str, str, str | None]]:
+        context = cast(
+            Context,
+            SimpleNamespace(
+                team=SimpleNamespace(id=1, timezone_info=ZoneInfo("UTC")),
+                user=SimpleNamespace(id=2),
+                today=today,
+                daily=lambda _name, compute: compute(),
+            ),
+        )
+        registered = next(s for s in load_sources() if s.name == "flags")
+        summary = FlagCallSummary(by_key=by_key, complete=complete, covers_all_environments=covers_all_environments)
+        with (
+            patch.object(flags, "list_flags_created_by", return_value=created_flags),
+            patch.object(flags, "summarize_flag_calls", return_value=summary),
+        ):
+            return [(c.title, c.detail, c.url) for c in registered.find(context).items]
+
+    def test_a_flag_that_reaches_half_the_people_is_a_risk_even_when_removal_is_blocked(self) -> None:
+        found = self._find(TUESDAY, [created("checkout", 60, flag_id=7, blocked=True)], {"checkout": calls(10, 40)})
+
+        self.assertEqual(
+            found,
+            [
+                (
+                    "Flag ‘checkout’ reached 75% fewer users in the last 7 days",
+                    "40 → 10 · Check the code that calls it",
+                    "/feature_flags/7",
+                )
+            ],
+        )
+
+    @parameterized.expand(
+        [
+            ("unused", created("old-banner", 30), {}, {}, "Flag ‘old-banner’ had no evaluations in the last 14 days"),
+            (
+                "same value",
+                created("old-banner", 30),
+                {"old-banner": SAME},
+                {},
+                "Flag ‘old-banner’ is true for everyone",
+            ),
+            ("unused but the call list is cut", created("old-banner", 30), {}, {"complete": False}, None),
+            (
+                "unused in one of several environments",
+                created("old-banner", 30),
+                {},
+                {"covers_all_environments": False},
+                None,
+            ),
+            (
+                "same value in one of several environments",
+                created("old-banner", 30),
+                {"old-banner": SAME},
+                {"covers_all_environments": False},
+                None,
+            ),
+            ("too new", created("old-banner", 13), {}, {}, None),
+            ("blocked by an experiment or a reference", created("old-banner", 30, blocked=True), {}, {}, None),
+            ("a remote configuration", created("old-banner", 30, remote_configuration=True), {}, {}, None),
+            ("risky to remove", created("kill-switch", 30), {}, {}, None),
+            ("a survey flag", created("survey-targeting-abc", 30), {}, {}, None),
+        ]
+    )
+    def test_monday_cleanup_names_an_unused_or_same_value_flag(
+        self,
+        _name: str,
+        flag: CreatedFlag,
+        by_key: dict[str, FlagCalls],
+        evidence: dict[str, bool],
+        title: str | None,
+    ) -> None:
+        found = self._find(MONDAY, [flag], by_key, **evidence)
+
+        self.assertEqual([t for t, _, _ in found], [title] if title else [])
+
+    @parameterized.expand(
+        [
+            ("monday list", MONDAY, 4, "flag_0, flag_1, flag_2 and 1 more"),
+            ("costly list", TUESDAY, 4, "Same value for everyone: flag_0, flag_1, flag_2 and 1 more"),
+        ]
+    )
+    def test_cleanup_detail_names_the_first_flags(self, _name: str, today: date, count: int, expected: str) -> None:
+        created_flags = [created(f"flag_{i}", 100 - i, flag_id=i) for i in range(count)]
+
+        found = self._find(today, created_flags, {flag.key: SAME for flag in created_flags})
+
+        self.assertEqual([d for _, d, _ in found], [expected])
+
+    def test_same_value_flags_called_less_than_the_cost_floor_stay_hidden_outside_monday(self) -> None:
+        cheap = calls(people=50, calls_this_week=99_999, values=1)
+
+        self.assertEqual(self._find(TUESDAY, [created("old-banner", 60)], {"old-banner": cheap}), [])
