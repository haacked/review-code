+import { useState } from "react";
+import { MemberOption } from "./MemberOption";
+import { useMembers } from "./useMembers";
+
+type Assignment = { workspaceId: string; memberId: string };
+
+export function Directory({ onAssign }: { onAssign: (assignment: Assignment) => void }) {
+    const [workspaceId, setWorkspaceId] = useState("north");
+    const [selectedId, setSelectedId] = useState<string | null>(null);
+    const { members, loading, error } = useMembers(workspaceId);
+
+    return (
+        <section aria-label="Assign a member">
+            <label>
+                Workspace
+                <select value={workspaceId} onChange={(event) => setWorkspaceId(event.target.value)}>
+                    <option value="north">North</option>
+                    <option value="south">South</option>
+                </select>
+            </label>
+            {loading && <p role="status">Loading members…</p>}
+            {error && <p role="alert">{error}</p>}
+            <div role="radiogroup" aria-label="Member">
+                {members.map((member) => (
+                    <MemberOption
+                        key={member.id}
+                        member={member}
+                        selected={selectedId === member.id}
+                        onSelect={() => setSelectedId(member.id)}
+                    />
+                ))}
+            </div>
+            <button
+                type="button"
+                disabled={loading || error !== null || selectedId === null}
+                onClick={() => {
+                    if (selectedId !== null) {
+                        onAssign({ workspaceId, memberId: selectedId });
+                    }
+                }}
+            >
+                Assign
+            </button>
+        </section>
+    );
+}
