+import type { Member } from "./useMembers";
+
+type Props = { member: Member; selected: boolean; onSelect: () => void };
+
+export function MemberOption({ member, selected, onSelect }: Props) {
+    return (
+        <div role="radio" aria-checked={selected} tabIndex={0} onClick={onSelect}>
+            {member.name}
+        </div>
+    );
+}
